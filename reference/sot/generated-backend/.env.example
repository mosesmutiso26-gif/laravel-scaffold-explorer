# ============================================================
# Riverside Academy ERP — Environment Configuration Template
# COPILOT MUST FILL THESE WITH LOCAL DEVELOPMENT VALUES ONLY.
# NEVER USE PRODUCTION CREDENTIALS.
# ============================================================

APP_NAME="Riverside Academy ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=riverside_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === External Integration Placeholders (all disabled by default) ===
MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@riverside-academy.local"
MAIL_FROM_NAME="${APP_NAME}"

SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

PAYMENT_GATEWAY=none
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

PUSH_PROVIDER=none
PUSH_API_KEY=

# === Security ===
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_AUTH=5
